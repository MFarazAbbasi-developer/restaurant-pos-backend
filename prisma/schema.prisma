generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ONLINE_CUSTOMER
  ADMIN
  STAFF
}

model Customer {
  id       String  @id @default(cuid())
  name     String  @db.VarChar(100)
  phone    String  @unique @db.VarChar(20)
  email    String? @unique @db.VarChar(100)
  password String  @db.VarChar(255) // store hashed passwords only
  isActive Boolean @default(true)
  role     Role    @default(ONLINE_CUSTOMER)

  street   String  @db.VarChar(150)
  city     String  @db.VarChar(100)
  state    String  @db.VarChar(100)
  zipCode  String  @db.VarChar(20)
  country  String  @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uncomment when orders are implemented
  // orders    Order[]
}

model Restaurant {
  id        String   @id @default(uuid())
  name      String?
  slug      String   @unique
  apiKey    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories Category[]
  menuItems  MenuItem[]
  deals      Deal[]
  stations   PrintStation[]
}

model PrintStation {
  id           String     @id @default(uuid())
  externalId   Int
  name         String?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  categories Category[]
  menuItems  MenuItem[]

  @@unique([externalId, restaurantId])
}

model Category {
  id           String   @id @default(uuid())
  externalId   Int
  name         String
  isActive     Boolean  @default(true)
  description  String?
  showInOrders Boolean
  rank         Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  defaultStation   PrintStation? @relation(fields: [defaultStationId], references: [id])
  defaultStationId String?

  items MenuItem[]

  @@unique([externalId, restaurantId])
  @@index([restaurantId])
}

model MenuItem {
  id             String   @id @default(uuid())
  externalId     Int
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  costPrice      Decimal  @db.Decimal(10, 2)
  foodPandaPrice Decimal? @db.Decimal(10, 2)
  isAvailable    Boolean
  imageUrl       String?
  weight         Decimal? @db.Decimal(10, 3)
  unit           String?
  rank           Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  station   PrintStation? @relation(fields: [stationId], references: [id])
  stationId String?

  dealItems DealItem[]

  @@unique([externalId, restaurantId])
  @@index([restaurantId])
  @@index([categoryId])
}

model Deal {
  id             String   @id @default(uuid())
  externalId     Int
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  costPrice      Decimal  @db.Decimal(10, 2)
  foodPandaPrice Decimal? @db.Decimal(10, 2)
  isAvailable    Boolean
  imageUrl       String?
  rank           Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  dealItems DealItem[]

  @@unique([externalId, restaurantId])
  @@index([restaurantId])
}

model DealItem {
  id       String @id @default(uuid())
  quantity Int

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  @@unique([dealId, menuItemId])
}
