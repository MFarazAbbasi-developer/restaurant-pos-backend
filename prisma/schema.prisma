
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  // orders    Order[]
  addresses Address[]

  role      Role     @default(ONLINE_CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // orders    Order[]
}

enum Role {
  ONLINE_CUSTOMER
  OFFLINE_CUSTOMER
  ADMIN
}

model Address {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  label     String // "Home", "Office"
  line1     String
  line2     String?
  city      String
  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

